{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, personal AI instructions, and theme preferences for Nova AI.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "customInstruction": {
          "type": "string",
          "maxLength": 1000
        },
        "accentColor": {
          "type": "string",
          "enum": ["violet", "blue", "emerald", "rose", "amber"]
        },
        "themeMode": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "backgroundStyle": {
          "type": "string",
          "enum": ["cosmos", "midnight-violet", "forest-emerald", "crimson-night", "golden-amber", "clean"]
        },
        "fontColor": {
          "type": "string",
          "enum": ["auto", "violet", "emerald", "rose", "amber", "blue"]
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 65000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private Arabic AI chat thread belonging to a single user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message inside a user's private conversation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "hasAttachment": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "conversationId", "role", "content", "hasAttachment", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "User issue report or suggestion submitted via the Nova AI Contact Us page with automatic AI triage.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": ["issue", "suggestion", "general"]
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed"]
        },
        "triageLevel": {
          "type": "string",
          "enum": ["pending", "simple", "urgent"]
        },
        "aiReply": {
          "type": "string",
          "maxLength": 4000
        },
        "aiSummary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "triagedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "senderName", "senderEmail", "category", "message", "status", "triageLevel", "createdAt"]
    },
    "VisitLog": {
      "title": "VisitLog",
      "description": "Verified user session visit record used for daily site traffic analytics in the owner dashboard.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "deviceType": {
          "type": "string",
          "enum": ["mobile", "tablet", "desktop"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "dateKey", "deviceType", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile, theme preferences, and custom AI assistant instructions; listable by site admin for user growth analytics."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Owner-only chat threads."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Owner-only chat messages under a conversation."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact Us feedback, bug reports, and suggestions readable by sender and owner admin."
    },
    "/visitLogs/{visitId}": {
      "schema": { "$ref": "#/entities/VisitLog" },
      "description": "Verified session visit records readable only by the owner admin for daily visit charts."
    }
  }
}
